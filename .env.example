# ==============================================================================
# SECURE DATABASE & BACKEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================
# Copy this file to .env and configure your secret credentials.
# ==============================================================================

# Prisma Postgres Connection URL
DATABASE_URL="postgres://username:password@pooled.db.prisma.io:5432/postgres?sslmode=require"

# Direct Database URL
DIRECT_URL="postgres://username:password@pooled.db.prisma.io:5432/postgres?sslmode=require"

# Backend Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api

# Admin Portal Secrets & Credentials (server-side only; never prefix with VITE_)
# ADMIN_PASSWORD: min 10 chars. ADMIN_API_KEY / ADMIN_SECRET_KEY: min 24 random chars (leave ADMIN_API_KEY empty to disable master-key login).
ADMIN_EMAIL=admin@posterstudio.com
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_API_KEY=your_long_random_admin_api_key_here
ADMIN_SECRET_KEY=your_long_random_session_signing_secret_here

# Security Encryption Keys & JWT Secrets
JWT_SECRET=your_jwt_secret_change_in_production
# Signs marketplace seller sessions (falls back to JWT_SECRET). Min 24 random chars.
SELLER_TOKEN_SECRET=your_long_random_seller_session_secret_here
SESSION_SECRET=your_session_secret_change_in_production

# Payment Gateway Secrets
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Cloudinary image uploads (server-side only)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# CORS: comma-separated list of allowed origins, e.g. https://yourstore.com,https://www.yourstore.com
CORS_ORIGIN=*
