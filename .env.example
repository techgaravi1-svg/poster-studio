# ==============================================================================
# SECURE DATABASE & BACKEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================
# Copy this file to .env and configure your secret credentials.
# ==============================================================================

# Prisma Postgres Connection URL
DATABASE_URL="postgres://username:password@pooled.db.prisma.io:5432/postgres?sslmode=require"

# Direct Database URL
DIRECT_URL="postgres://username:password@pooled.db.prisma.io:5432/postgres?sslmode=require"

# Backend Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api

# Admin Portal Secrets & Credentials
ADMIN_EMAIL=admin@posterstudio.com
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_API_KEY=your_admin_api_key_here
ADMIN_SECRET_KEY=your_admin_secret_key_here

# Security Encryption Keys & JWT Secrets
JWT_SECRET=your_jwt_secret_change_in_production
SESSION_SECRET=your_session_secret_change_in_production

# Payment Gateway Secrets
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# CORS
CORS_ORIGIN=*
