{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node -e \"if(!process.env.npm_config_user_agent||!process.env.npm_config_user_agent.startsWith('pnpm/')){console.error('Use pnpm instead');process.exit(1)}try{require('fs').rmSync('package-lock.json',{force:true});require('fs').rmSync('yarn.lock',{force:true})}catch(e){}\"",
    "postinstall": "pnpm --filter @workspace/db run db:generate",
    "build": "pnpm --filter @workspace/db run db:generate && pnpm run typecheck && pnpm --filter @workspace/poster-studio run build && pnpm --filter @workspace/api-server run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "dev": "pnpm --filter @workspace/poster-studio run dev",
    "dev:all": "pnpm -r --if-present run dev",
    "dev:store": "pnpm --filter @workspace/poster-studio run dev",
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "dev:sandbox": "pnpm --filter @workspace/mockup-sandbox run dev"
  },
  "private": true,
  "dependencies": {
    "@prisma/client": "6.4.1",
    "@replit/connectors-sdk": "^0.4.3",
    "cors": "^2.8.5",
    "dotenv": "^18.0.8",
    "express": "^5.2.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@esbuild/win32-x64": "^0.28.2",
    "@rollup/rollup-win32-x64-msvc": "4.63.1",
    "lightningcss-win32-x64-msvc": "1.32.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "@esbuild/win32-x64",
      "@rollup/rollup-win32-x64-msvc",
      "lightningcss-win32-x64-msvc",
      "esbuild"
    ]
  }
}
