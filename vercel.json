{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "artifacts/poster-studio/dist",
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ]
}
